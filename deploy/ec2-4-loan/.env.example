# EC2-4 (loan-service). On the instance, create this as .env with:  nano .env
# Write KEY=value with no quotes and no spaces around =.
# Atlas connection string. It must end with /loandb, or MongoDB silently uses "test".
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/loandb
INTERNAL_KEY=<same-value-on-every-instance>
# Private IPv4 address of EC2-3 (EC2 console -> instance -> Private IPv4)
EQUIPMENT_PRIVATE_IP=<EC2-3-private-ip>
