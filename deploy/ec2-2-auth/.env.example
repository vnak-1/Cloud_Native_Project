# EC2-2 (registration + login). On the instance, create this as .env with:  nano .env
# Write KEY=value with no quotes and no spaces around =.
# Atlas connection string. It must end with /userdb, or MongoDB silently uses "test".
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/userdb
INTERNAL_KEY=<same-value-on-every-instance>
# Signs login tokens. It must match JWT_SECRET on EC2-1.
JWT_SECRET=<same-value-as-on-EC2-1>
JWT_EXPIRES_IN=24h
# The first admin, created on the first start if no admin exists yet
ADMIN_EMAIL=admin@aupp.edu.kh
ADMIN_PASSWORD=<choose-a-strong-password>
