# EC2-3 (nginx + equipment-1 + equipment-2). On the instance, create this as .env with:  nano .env
# Write KEY=value with no quotes and no spaces around =.
# Atlas connection string. It must end with /equipmentdb, or MongoDB silently uses "test".
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/equipmentdb
INTERNAL_KEY=<same-value-on-every-instance>
