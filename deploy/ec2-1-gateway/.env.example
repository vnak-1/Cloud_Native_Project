# EC2-1 (gateway). On the instance, create this as .env with:  nano .env
# Write KEY=value with no quotes and no spaces around =.
# JWT_SECRET must match EC2-2. INTERNAL_KEY must be the same on all four instances.
JWT_SECRET=<same-value-as-on-EC2-2>
INTERNAL_KEY=<same-value-on-every-instance>
# Private IPv4 addresses of the other instances (EC2 console -> instance -> Private IPv4)
AUTH_PRIVATE_IP=<EC2-2-private-ip>
EQUIPMENT_PRIVATE_IP=<EC2-3-private-ip>
LOAN_PRIVATE_IP=<EC2-4-private-ip>
