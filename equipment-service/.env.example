# Copy this file to .env and fill in real values. .env is gitignored, so it's never committed.
PORT=3003
SERVICE_NAME=equipment-service
# Which replica this is. docker compose sets it per replica; this value is for running with node.
INSTANCE_ID=equipment-1
# Atlas connection string. It must end with /equipmentdb, or MongoDB silently uses "test".
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/equipmentdb
# Shared secret: the gateway and loan-service send it in the x-internal-key header.
INTERNAL_KEY=<long-random-string>
