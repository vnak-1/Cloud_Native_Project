# Copy this file to .env and fill in real values. .env is gitignored, so it's never committed.
PORT=3002
SERVICE_NAME=login-service
# Atlas connection string. It must end with /userdb, or MongoDB silently uses "test".
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/userdb
# The same shared secret as the gateway and the other services
INTERNAL_KEY=<long-random-string>
# Signs the login tokens. It must be the same value as JWT_SECRET in the gateway's .env.
JWT_SECRET=<another-long-random-string>
# How long a token stays valid (24h as in the course; "1h", "7d" also work)
JWT_EXPIRES_IN=24h
