# Copy this file to .env and fill in real values. .env is gitignored, so it's never committed.
PORT=3000
SERVICE_NAME=gateway
# Checks login tokens. It must be the same value as JWT_SECRET in login-service's .env.
JWT_SECRET=<another-long-random-string>
# The same shared secret as every internal service
INTERNAL_KEY=<long-random-string>
# Where the services are when you run everything with node on your Mac.
# docker compose replaces these with Docker service names; on EC2 they're private IPs.
REGISTRATION_URL=http://localhost:3001
LOGIN_URL=http://localhost:3002
EQUIPMENT_URL=http://localhost:3003
LOAN_URL=http://localhost:3004
