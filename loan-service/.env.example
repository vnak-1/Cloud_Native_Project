# Copy this file to .env and fill in real values. .env is gitignored, so it's never committed.
PORT=3004
SERVICE_NAME=loan-service
# Atlas connection string. It must end with /loandb, or MongoDB silently uses "test".
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/loandb
# The same shared secret as the gateway and equipment-service
INTERNAL_KEY=<long-random-string>
# Where the equipment service is. With docker compose this is the nginx load balancer
# (http://equipment-lb:8080). When running with node before nginx exists: http://localhost:3003
EQUIPMENT_URL=http://localhost:3003
